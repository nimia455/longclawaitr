function esc(t){return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function md(t){const B=[];t=t.replace(/```(\w*)\n?([\s\S]*?)```/g,(_,l,c)=>{B.push('<pre><code>'+esc(c.replace(/\n$/,''))+'</code></pre>');return '\u0000'+(B.length-1)+'\u0000'});
const inl=s=>esc(s).replace(/`([^`\n]+)`/g,'<code>$1</code>').replace(/\*\*([^*\n]+)\*\*/g,'<b>$1</b>').replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<i>$2</i>').replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
const L=t.split('\n'),o=[],isB=l=>/^(#{1,4}\s|\s*[-*•]\s|\s*\d+[.)]\s|>|\|)/.test(l);let i=0,m;
while(i<L.length){const l=L[i];
if(!l.trim()){i++;continue}
if(m=l.match(/^\u0000(\d+)\u0000$/)){o.push(B[+m[1]]);i++;continue}
if(m=l.match(/^(#{1,4})\s+(.*)/)){const n=m[1].length+1;o.push('<h'+n+'>'+inl(m[2])+'</h'+n+'>');i++;continue}
if(/^\s*[-*•]\s+/.test(l)){const it=[];while(i<L.length&&/^\s*[-*•]\s+/.test(L[i]))it.push('<li>'+inl(L[i++].replace(/^\s*[-*•]\s+/,''))+'</li>');o.push('<ul>'+it.join('')+'</ul>');continue}
if(/^\s*\d+[.)]\s+/.test(l)){const it=[];while(i<L.length&&/^\s*\d+[.)]\s+/.test(L[i]))it.push('<li>'+inl(L[i++].replace(/^\s*\d+[.)]\s+/,''))+'</li>');o.push('<ol>'+it.join('')+'</ol>');continue}
if(/^>\s?/.test(l)){const q=[];while(i<L.length&&/^>\s?/.test(L[i]))q.push(inl(L[i++].replace(/^>\s?/,'')));o.push('<blockquote>'+q.join('<br>')+'</blockquote>');continue}
if(/^\|.+\|\s*$/.test(l)&&i+1<L.length&&/^\|?\s*:?-{2,}/.test(L[i+1])){const cells=r=>r.trim().replace(/^\||\|$/g,'').split('|').map(x=>inl(x.trim()));const hd=cells(l);i+=2;const rows=[];while(i<L.length&&/^\|.+\|\s*$/.test(L[i]))rows.push(cells(L[i++]));o.push('<div class="tw"><table><thead><tr>'+hd.map(x=>'<th>'+x+'</th>').join('')+'</tr></thead><tbody>'+rows.map(r=>'<tr>'+r.map(x=>'<td>'+x+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>');continue}
if(/^-{3,}\s*$/.test(l)){o.push('<hr>');i++;continue}
const p=[];while(i<L.length&&L[i].trim()&&(p.length===0||!isB(L[i])))p.push(inl(L[i++]));o.push('<p>'+p.join('<br>')+'</p>')}
return o.join('').replace(/\u0000(\d+)\u0000/g,(_,n)=>B[+n])}
