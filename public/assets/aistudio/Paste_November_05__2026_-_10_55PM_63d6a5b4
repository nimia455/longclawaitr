<script>
const $=s=>document.querySelector(s);
const IC=n=>'<svg class="i"><use href="#i-'+n+'"/></svg>';
const LG='<svg viewBox="0 0 32 32"><circle cx="11.5" cy="16" r="8.5" fill="none" stroke="var(--tx)" stroke-width="3.6"/><circle cx="20.5" cy="16" r="8.5" fill="none" stroke="var(--tx)" stroke-width="3.6"/><path d="M13 7.6A8.5 8.5 0 0 1 18.4 11" fill="none" stroke="var(--bg)" stroke-width="6.4"/><path d="M13 7.6A8.5 8.5 0 0 1 18.4 11" fill="none" stroke="var(--tx)" stroke-width="3.6"/><path d="M19 24.4A8.5 8.5 0 0 1 13.5 20.9" fill="none" stroke="var(--bg)" stroke-width="6.4"/><path d="M19 24.4A8.5 8.5 0 0 1 13.5 20.9" fill="none" stroke="var(--tx)" stroke-width="3.6"/></svg>';const avt=()=>{const a=document.createElement('div');a.className='av2';a.innerHTML=LG;return a};
const S={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}},del(k){try{localStorage.removeItem(k)}catch(e){}}};
let user=null,chats=[],cur=null,mode='chat',busy=false,authTab='in';
const MODES={chat:'Sıcak, net ve yardımsever bir asistan olarak sohbet et.',sum:'Kullanıcı bir metin yapıştırırsa kısa ve düzenli özetle; çeviri istenirse istenen dile doğal biçimde çevir.',write:'E-posta, mesaj ve metin taslakları yaz; istenen tona (resmi, samimi, kısa) uy.'};
const SUG=['Yarınki toplantı için kısa bir hatırlatma e-postası yaz','Kuantum bilgisayarları basitçe anlat','Bu paragrafı üç cümlede özetle','“Merhaba, nasılsın?” cümlesini İngilizceye çevir'];
function theme(){const r=document.documentElement,d=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme:dark)').matches;r.dataset.theme=d?'light':'dark';S.set('lc_theme',r.dataset.theme)}
(function(){const t=S.get('lc_theme');if(t)document.documentElement.dataset.theme=t})();
function openAuth(t){tab(t);$('#ov').classList.add('on')}
function closeAuth(){$('#ov').classList.remove('on')}
function tab(t){authTab=t;$('#t-in').classList.toggle('on',t==='in');$('#t-up').classList.toggle('on',t==='up');$('#nm').style.display=t==='up'?'block':'none';$('#go').textContent=t==='up'?'Hesap oluştur':'Giriş yap';$('#err').textContent='';$('#tos').style.display=t==='up'?'flex':'none';$('#fg').style.display=t==='in'?'inline-block':'none'}
async function hash(s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('lc:'+s));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
async function submitAuth(){
const em=$('#em').value.trim().toLowerCase(),pw=$('#pw').value,nm=$('#nm').value.trim(),err=$('#err');if(authTab==='up'&&!$('#tk').checked)return err.textContent='Devam etmek için şartları kabul etmelisin.';
if(!/^\S+@\S+\.\S+$/.test(em))return err.textContent='Geçerli bir e-posta gir.';
if(pw.length<6)return err.textContent='Şifre en az 6 karakter olmalı.';
const users=S.get('lc_users',{}),h=await hash(pw);
if(authTab==='up'){if(users[em])return err.textContent='Bu e-posta zaten kayıtlı. Giriş yapmayı dene.';users[em]={name:nm||em.split('@')[0],h};S.set('lc_users',users)}
else if(!users[em]||users[em].h!==h)return err.textContent='E-posta veya şifre hatalı.';
login(em,users[em].name)}

function login(em,name){user={email:em,name};S.set('lc_session',user);closeAuth();enter()}
function logout(){S.del('lc_session');user=null;$('#app').classList.remove('on');$('#landing').style.display='';$('#menu').classList.remove('on')}
let delArm=false;
function delAcc(){const b=$('#del');if(!delArm){delArm=true;b.textContent='Emin misin? Tekrar tıkla';setTimeout(()=>{delArm=false;b.textContent='Hesabı ve verileri sil'},4000);return}
const u=S.get('lc_users',{});delete u[user.email];S.set('lc_users',u);S.del('lc_chats_'+user.email);delArm=false;b.textContent='Hesabı ve verileri sil';logout()}
function enter(){$('#landing').style.display='none';$('#app').classList.add('on');$('#un').textContent=user.name;$('#av').textContent=user.name[0].toUpperCase();$('#mail').textContent=user.email;chats=S.get('lc_chats_'+user.email,[]);setDepth(S.get('lc_dp','mid'));cur=chats[0]?.id||null;if(!cur)newChat();else{renderList();renderMsgs()}}
const save=()=>S.set('lc_chats_'+user.email,chats);
const chat=()=>chats.find(c=>c.id===cur);
function newChat(){const c={id:Date.now()+'',title:'Yeni sohbet',msgs:[]};chats.unshift(c);cur=c.id;save();renderList();renderMsgs();$('#side').classList.remove('on')}
function renderList(){const l=$('#list');const cc=chat();if(cc)$('#ttl').textContent=cc.title;l.innerHTML='';const qq=($('#q').value||'').trim().toLowerCase();[...chats].filter(c=>!qq||c.title.toLowerCase().includes(qq)||c.msgs.some(m=>m.content.toLowerCase().includes(qq))).sort((a,b)=>(b.pin?1:0)-(a.pin?1:0)).forEach(c=>{const d=document.createElement('div');d.className='it'+(c.id===cur?' on':'');const s=document.createElement('span');s.textContent=c.title;d.append(s);
