rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'phoneNumber', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation for ChatSession
    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'mode', 'depth', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'mode', 'depth', 'pin', 'messages', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && (data.mode in ['chat', 'sum', 'write'])
        && (data.depth in ['fast', 'mid', 'deep'])
        && (!('pin' in data) || data.pin is bool)
        && (!('messages' in data) || (data.messages is list && data.messages.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation for SlashCommand
    function isValidSlashCommand(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'prompt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'description', 'prompt', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 32 && data.name.matches('^[a-z0-9][a-z0-9_\\-]{0,31}$')
        && (!('description' in data) || (data.description is string && data.description.size() <= 140))
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'phoneNumber', 'emailVerified', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Chat sessions subcollection
      match /chats/{chatId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming())
          && incoming().id == chatId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'depth', 'pin', 'messages', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
      }

      // Custom slash commands subcollection
      match /commands/{commandId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(commandId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(commandId)
          && isValidSlashCommand(incoming())
          && incoming().id == commandId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(commandId)
          && isValidSlashCommand(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'prompt', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(commandId);
      }
    }

    // Connectivity test endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
