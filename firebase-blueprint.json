{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing account metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 32
        },
        "emailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User chat conversation session with messages and settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": ["chat", "sum", "write"]
        },
        "depth": {
          "type": "string",
          "enum": ["fast", "mid", "deep"]
        },
        "pin": {
          "type": "boolean"
        },
        "messages": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "mode", "depth", "createdAt", "updatedAt"]
    },
    "SlashCommand": {
      "title": "SlashCommand",
      "description": "User-defined custom slash command shortcut and prompt template",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,31}$"
        },
        "description": {
          "type": "string",
          "maxLength": 140
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name", "prompt", "createdAt", "updatedAt"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Smoke test connection health verification document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles with owner-only access"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Stores conversation sessions for a specific user"
    },
    "/users/{userId}/commands/{commandId}": {
      "schema": "SlashCommand",
      "description": "Stores custom slash commands created by a specific user"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Test collection for SDK connectivity checks"
    }
  }
}
