# GEMINI_API_KEY: Primary unpaid Gemini API key for AI calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_2: Optional 2nd unpaid Gemini API key used automatically if key 1 fails or hits quota.
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"

# GEMINI_API_KEY_3: Optional 3rd unpaid Gemini API key used automatically if keys 1 and 2 fail or hit quota.
GEMINI_API_KEY_3="MY_GEMINI_API_KEY_3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Optional subpath when hosting statically (e.g. GitHub Pages "/repo-name/").
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Optional backend server origin when frontend is hosted on GitHub Pages.
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Optional comma-separated custom frontend origins allowed to call /api/* via CORS (*.github.io is allowed automatically).
ALLOWED_ORIGINS=""
